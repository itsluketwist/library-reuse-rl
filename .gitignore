# project
todo.txt
output/archive
data/raw

# skywork is a large download (~1.3GB after filtering), so it is not committed - re-run
# data/build/download_skywork.py to regenerate it. the small, committed product_choice and
# library_usage splits (and the eval sets under data/eval) ARE tracked, since they are the
# actual dataset deliverable and can't be rebuilt without the (unlicensed) vendored seed below.
data/train/skywork
data/train/product_choice

# vendored amplify seed the build pipelines fetch - upstream ships no licence, so we don't
# commit it; re-run data/build/amplify/vendor_seed.py to regenerate it locally.
data/build/vendor

# libreusebench: keep the fetched seed and disposable harness environments out of git.
# track benchmark/artefacts for the build history and author reviews, alongside the
# final benchmark splits under benchmark/libreusebench/data.
benchmark/vendor
benchmark/results/example
.libreuseeval-venv
.libreuseeval-venvs

