# copy this to .env (gitignored) and fill in real values

# where downloaded model weights are cached. on isambard this must be under $PROJECTDIR:
# the models run to hundreds of gigabytes and $HOME only has 100GiB (scripts/setup_job.sh
# refuses to run otherwise), e.g. HF_HOME=/projects/u6yb/twist.u6yb/hf-cache
HF_HOME=
HF_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
